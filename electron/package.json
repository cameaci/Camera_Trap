{
  "name": "wsp-cameratrap-desktop",
  "version": "0.0.0-dev",
  "description": "WSP CameraTrap - camera trap image analysis for WSP",
  "main": "dist/main.js",
  "homepage": "https://github.com/cameaci/Camera_Trap",
  "author": {
    "name": "WSP"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "tsc && electron .",
    "build": "tsc",
    "start": "electron .",
    "package": "electron-builder",
    "test:e2e": "tsc && playwright test"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^20.10.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.62.0",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.wsp.cameratrap",
    "productName": "WSP CameraTrap",
    "copyright": "Copyright © WSP",
    "directories": {
      "output": "dist-build"
    },
    "publish": null,
    "generateUpdatesFilesForAllChannels": false,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/backend",
        "to": "backend"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "WSP-CameraTrap-Setup-${version}.${ext}",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WSP CameraTrap",
      "uninstallDisplayName": "WSP CameraTrap",
      "include": "build/installer.nsh"
    }
  }
}
